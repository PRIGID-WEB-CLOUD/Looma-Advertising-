{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "looma-ads",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sdk/*", "/admin", "/admin/*"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "looma-ads-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENT_QUEUE",
        "queue": "looma-ads-events"
      }
    ],
    "consumers": [
      {
        "queue": "looma-ads-events",
        "max_batch_size": 25,
        "max_batch_timeout": 5
      }
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "42733ba1ed544ceb9ab1d29b0b6d0b5e"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "0 0 * * *"]
  }
}
